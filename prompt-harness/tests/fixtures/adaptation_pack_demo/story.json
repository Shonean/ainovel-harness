  "start": "n001",
  "nodes": [
    {
      "id": "n001",
      "type": "scene",
      "title": "纸人教室中醒来",
      "background": "bg_classroom_night",
      "present": ["char_chen"],
      "lines": [
        { "kind": "narration", "text": "深夜的旧教室里，粉笔灰在路灯光柱中缓缓下沉，每个座位上都坐着一个纸人。" },
        { "kind": "inner", "text": "这是哪儿？我明明记得刚交完最后一科的卷子……" },
        { "kind": "stage", "cue": "paper_figures_turn", "text": "所有纸人同时转过头来。" },
        { "kind": "dialogue", "speaker": "char_chen", "expression": "fear", "text": "谁在看我？" }
      ],
      "interaction_refs": ["int_cabinet"],
      "next": "c001",
      "source": { "arc_id": "arc_demo0001", "scene_index": 0 }
    },
    {
      "id": "c001",
      "type": "choice",
      "prompt": "你要先做什么？",
      "options": [
        { "text": "先看那张病人卡", "next": "n002", "set": { "flags.read_card": true } },
        { "text": "先去翻储物柜", "next": "n002", "set": { "flags.searched_cabinet": true } }
      ],
      "converge_to": "n002",
      "llm_zone": "zone_c001",
      "source": { "arc_id": "arc_demo0001", "chapter": 1 }
    },
    {
      "id": "n002",
      "type": "scene",
      "title": "病人卡上的名字",
      "background": "bg_hallway_dusk",
      "present": ["char_chen", "char_lin"],
      "lines": [
        { "kind": "narration", "text": "走廊尽头，一张病人卡从课桌缝里滑出来，正面朝上。" },
        { "kind": "dialogue", "speaker": "char_lin", "expression": "calm", "text": "你终于把它捡起来了。" },
        { "kind": "dialogue", "speaker": "char_chen", "expression": "fear", "text": "这名字……是我自己的。" },
        { "kind": "stage", "cue": "light_flicker", "text": "灯管闪烁两下，熄了半边。" }
      ],
      "next": "end_a",
      "source": { "arc_id": "arc_demo0001", "scene_index": 1 }
    },
    {
      "id": "end_a",
      "type": "ending",
      "title": "接受真相",
      "text": "陈守念把病人卡翻面，接受了自己也在名单上的事实。",
      "condition": "flags.read_card"
    },
    {
      "id": "end_b",
      "type": "ending",
      "title": "拒绝离开",
      "text": "陈守念把卡塞回桌缝，转身走进更深的黑暗。",
      "condition": null
    }
  ]
}
