# ┌─────────────────────────────────────────────────────────────┐
# │  ⚠️  v5.2 起：此文件仅用于 prompt-harness 独立运行（8777 端口）  │
# │                                                             │
# │  【推荐】从主系统 8765 端口进入，配置由主系统统一管理            │
# │  唯一真相源：~/.claude/ainovel-write/.env                    │
# │  变量名前缀：AINOVEL_                                         │
# │                                                             │
# │  独立调试模式（deprecated）才需要本文件                        │
# └─────────────────────────────────────────────────────────────┘

# LLM (火山 Ark GLM5.2)
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_PRO=your-glm5.2-endpoint-id

# Embedding (OpenAI-compatible)
EMBED_API_KEY=your_embedding_api_key
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Server
HOST=127.0.0.1
PORT=8777  # deprecated — 推荐使用主系统 8765 端口
