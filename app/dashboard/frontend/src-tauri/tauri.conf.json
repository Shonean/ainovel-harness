{
  "$schema": "https://raw.githubusercontent.com/nicedoc/schemas-tauri-v2/main/src/tauri-conf.json",
  "productName": "AInovel Harness",
  "version": "0.1.0",
  "identifier": "com.ainovel.write",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:8765",
    "beforeDevCommand": "",
    "beforeBuildCommand": "if exist dist rmdir /s /q dist && npm run build"
  },
  "app": {
    "windows": [],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "AInovel Harness",
      "menuOnLeftClick": false
    },
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:8765 ws://127.0.0.1:8765; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true
      }
    },
    "linux": {
      "deb": {
        "depends": ["python3"]
      }
    }
  }
}
